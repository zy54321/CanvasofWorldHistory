# Canvas of World History —— 运行配置模板
#
# 用法：复制为 config/.env 并填写真实值。
#       config/.env 不得提交到 Git，也不得打进任何 Release 包。
#
# 注意：本文件是模板，所有敏感值均为空。

# ---- PostgreSQL / PostGIS（生产）----
POSTGRES_DB=canvas_history
POSTGRES_USER=canvas_app
# 必填。用 openssl rand -base64 24 | tr -d '/+=' | cut -c1-24 生成
POSTGRES_PASSWORD=

# 宿主机映射端口（仅 127.0.0.1）
DB_HOST_PORT=15432

TZ=Asia/Shanghai

# ---- 应用端口 ----
API_PORT=5180

# ---- 数据库写入白名单 ----
# 单 Jar 实例同时提供页面与 API，因此正式环境必须可写：填 canvas_history。
# 留空 = 全库禁写，写操作一律 403。
DB_WRITE_ALLOWED_DATABASES=canvas_history

# ---- 前端运行时配置 ----
# MapTiler key 不进入构建产物，部署时由 web/config.js 在浏览器端注入：
#   window.__ENV__ = { MAPTILER_KEY: '你的受限 API key' };
# 留空则地图降级为无底图模式（界面会明确提示）。
MAPTILER_API_KEY=

# ---- 统一 Compose 运行参数（PROD 编排必需）----
# compose.yaml 中 app 服务的镜像标签与 config.js 挂载源。
# 由 03_发布Prod.bat 安装/更新，切换成功后自动回写为本机实际部署值。
# 手工执行 docker compose ... ps/logs 时，这两项由 --env-file 提供。
#
# 路径请一律使用正斜杠：.env 的值里反斜杠会被当作转义序列，可能把 Windows
# 路径截断（曾导致 bind source 变成 "E://01_Work//..." 而挂载失败）。
CANVAS_APP_IMAGE=canvas-history-app:pending
CANVAS_CONFIG_JS_PATH=C:/path/to/CanvasofWorldHistory/config/web/config.js
