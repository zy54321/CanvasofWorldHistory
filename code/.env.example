# 《世界历史时空画布》环境变量模板
# 使用方式：cp .env.example .env ，然后把 POSTGRES_PASSWORD 换成真实随机密码
# .env 已被 .gitignore 忽略，禁止提交到 Git。

# Compose 项目标识（决定容器名前缀）
COMPOSE_PROJECT_NAME=canvas-history

# ---- PostgreSQL / PostGIS ----
POSTGRES_DB=canvas_history
POSTGRES_USER=canvas_app
# 留空会在容器启动时失败，必须填写（建议 openssl rand -base64 24 | tr -d '/+=' | cut -c1-24）
POSTGRES_PASSWORD=
# 宿主机映射端口，仅绑定 127.0.0.1
DB_HOST_PORT=55432

TZ=Asia/Shanghai

# ---- 后续阶段预留（阶段五使用时再填写）----
# 浏览器可见的地图 key，只能是 MapTiler 的 API key，禁止填 Service token
VITE_MAPTILER_API_KEY=
API_HOST_PORT=8088
WEB_HOST_PORT=5180
