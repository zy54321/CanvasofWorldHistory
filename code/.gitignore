# ---- 凭证与本地环境 ----
.env
.env.local
.env.*.local
!.env.example

# ---- 原始数据（体积大、含第三方数据，不入库）----
data/staging/*
!data/staging/.gitkeep
# M4-4a：全量暂存（七张 CSV 合计约 260 MB），按同一约定不入库；
# 只保留可审计的两份清单（运行 manifest 与 SHA256 清单），它们能证明库里缺的那些文件是什么。
data/staging_m4_3/*
!data/staging_m4_3/manifest.json
!data/staging_m4_3/SHA256SUMS.txt
data/backup/
*.dump
*.backup

# ---- Java / Spring Boot ----
backend/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
backend/.mvn/wrapper/maven-wrapper.jar

# ---- Node / Vue ----
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- IDE / 系统 ----
.idea/
*.iml
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- 日志 ----
logs/
*.log

# ---- 自检脚本依赖 ----
ops/.deps/
data/raw/
